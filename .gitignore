# Secrets / local config
.env
config/credentials.yaml
config/leg_assignments.yaml
# Runtime config — seeded from config/settings.example.yaml on first run, then
# mutated by the Settings page / mode switch. Tracking it makes pulls conflict.
config/settings.yaml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Logs / data
logs/
*.log

# Tooling
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/

# Runtime data
data/trades.json
# Persisted signal window (resume warm-up across a restart) — runtime only
data/signal_window.json
# Untracked-close ledger (orphan/reconcile cleanup costs) — runtime only
data/untracked_closes.json
# Cached Arrow session token (a credential — never commit)
data/arrow_session.json
# What-if-held shadow watches — runtime only
data/whatif_shadow.json
# Liveness heartbeat (written every few seconds) — runtime only
data/heartbeat.txt
# SQLite analysis persistence (trade_review, sd_touches, shadow, market_data) — runtime
data/analysis.db
data/analysis.db-journal
