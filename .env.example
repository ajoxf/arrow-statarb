# Arrow credentials — copy to .env and fill in. Never commit the real .env.
# TOTP secret is the base32 SEED from your authenticator setup, NOT the
# 6-digit code. The host running this must have its static IP registered
# with Arrow (SEBI requirement).

ARROW_APP_ID=
ARROW_USER_ID=
ARROW_PASSWORD=
ARROW_API_SECRET=
ARROW_TOTP_SECRET=

# Optional web server overrides
# ARROW_HOST=0.0.0.0
# ARROW_PORT=5000
# LOG_LEVEL=INFO
